{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.vitest.ts",
    "src/**/test-support.ts",
    "src/quicklens/**",
    "src/cells/quicklens-demo/**",
    "src/cells/quicklens-graph/**",
    "src/cells/quicklens-ui/**"
  ]
}
