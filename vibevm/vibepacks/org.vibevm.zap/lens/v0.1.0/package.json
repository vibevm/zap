    "@eslint/js": "9.39.0",
    "@types/node": "24.10.1",
    "eslint": "9.39.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
