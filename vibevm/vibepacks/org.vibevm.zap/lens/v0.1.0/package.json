  "scripts": {
    "clean": "node tooling/clean-dist.js",
    "build:node": "tsc -p tsconfig.build.json",
    "build:quicklens:browser": "vite build --config quicklens.vite.config.ts",
    "build:quicklens:electron": "tsc -p tsconfig.electron.json && vite build --config quicklens.preload.vite.config.ts",
    "build:quicklens": "npm run build:quicklens:browser && npm run build:quicklens:electron",
    "build": "npm run clean && npm run build:node && npm run build:quicklens",
    "dev:quicklens": "vite --config quicklens.vite.config.ts --host 127.0.0.1",
    "preview:quicklens": "vite preview --config quicklens.preview.config.ts --host 127.0.0.1",
    "start:quicklens-service": "node dist/quicklens.js",
    "start:quicklens-web": "node dist/quicklens-web.js",
    "start:wayfinder": "node dist/wayfinder.js",
    "start": "node dist/zap-quick-lens.js",
    "quicklens:demo": "npm run build:quicklens && electron dist/quicklens/electron/main.js --demo",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.quicklens.test.json --noEmit",
    "test:node": "node --test --test-concurrency=4 \"src/**/*.test.ts\"",
    "simulate:mock": "node --experimental-strip-types src/zap-mock-simulate.ts",
    "test:mock": "npm run simulate:mock -- --all",
    "test:tooling": "node --test \"tooling/**/*.test.js\"",
    "test:types": "vitest run",
    "test": "npm run test:node && npm run test:tooling && npm run test:types",
    "lint": "eslint src",
    "check:quicklens:boundary": "node tooling/check-quicklens-browser-boundary.js",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run lint && npm run check:quicklens:boundary && npm run build",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@qwik.dev/core": "2.0.0-beta.43",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.3.0",
    "graphology": "0.26.0",
    "lossless-json": "4.3.1",
    "sigma": "3.0.3",
    "zod": "4.1.11"
  },
