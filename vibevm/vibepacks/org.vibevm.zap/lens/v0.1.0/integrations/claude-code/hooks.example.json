{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<PLUGIN_ROOT>/scripts/codlens-hook.mjs\" claude_code",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<PLUGIN_ROOT>/scripts/codlens-hook.mjs\" claude_code",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<PLUGIN_ROOT>/scripts/codlens-hook.mjs\" claude_code",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
